# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real secret here.
#
#     cp .env.example .env
#
# Only used by docker-compose.prod.yml. The development stack needs none of it.

# ── Database ────────────────────────────────────────────────────────────────
# The development password is "ficatlas" and is in the git history, so it is
# public. Generate a fresh one:
#
#     openssl rand -base64 32
#
# Changing this AFTER the volume exists does not change the password already
# stored in the database — Postgres only reads POSTGRES_PASSWORD when it
# initialises an empty data directory. To rotate on an existing install:
#
#     docker compose exec db psql -U ficatlas -c "ALTER USER ficatlas PASSWORD 'new';"
#
# then put the same value here.
POSTGRES_PASSWORD=

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# From one.dash.cloudflare.com > Networks > Tunnels > Create a tunnel > Docker.
# The dashboard shows a `docker run ... --token eyJ...` command; the token is
# the long eyJ... string. It grants control of the tunnel — treat it as a
# password.
#
# Configure the tunnel's public hostname to route to:  http://frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=

# ── Cloudflare analytics (optional) ─────────────────────────────────────────
# The traffic page counts pageviews from a beacon the BROWSER sends, so it
# cannot see crawlers — they do not run JavaScript. Cloudflare already counts
# every request at the edge, so these two variables add the missing half:
# crawler and asset traffic, cache hit ratio, and where in the world requests
# come from. Read-only, and they store nothing new.
#
# This is NOT the tunnel token above. Create a separate one at
# dash.cloudflare.com > My Profile > API Tokens > Create Token > Custom, with
# the single permission:  Zone > Analytics > Read
#
# The zone id is on the domain's Overview page, bottom right.
# Named FICATLAS_ rather than CLOUDFLARE_ deliberately. Compose interpolates
# from the SHELL before it reads this file, so a CLOUDFLARE_API_TOKEN exported
# by any other Cloudflare tooling -- the CLI, an MCP plugin, a stray line in
# ~/.bashrc -- silently wins over whatever is set here, and the site then
# reports "Invalid API Token" while this file plainly contains a good one.
# Measured: a 10-character placeholder in .bashrc overrode a working token.
# The container still receives them as CLOUDFLARE_API_TOKEN / CLOUDFLARE_ZONE_ID.
FICATLAS_CF_API_TOKEN=
FICATLAS_CF_ZONE_ID=

# ── Who may register ────────────────────────────────────────────────────────
# open   — anyone can create an account
# invite — only with SIGNUP_CODE below
# closed — nobody; accounts are created by hand
#
# The FIRST account created becomes owner (see init_db.py), so make yours before
# opening registration to anyone else.
SIGNUP_MODE=invite
SIGNUP_CODE=

# ── Uptime monitoring ───────────────────────────────────────────────────────
# A dead-man's switch URL. watchdog.sh pings it every 5 minutes ONLY when the
# stack is genuinely healthy, so the alert is the ping going missing — which is
# the only way to learn about a power cut or a dead machine, since a watchdog on
# the box that died cannot tell you it died.
#
# Free options: healthchecks.io, cronitor.io, or an Uptime Kuma push monitor
# hosted somewhere other than this machine.
HEARTBEAT_URL=

# ── Local / tailnet access ──────────────────────────────────────────────────
# This machine's Tailscale address (`tailscale ip -4`). The production overlay
# binds the frontend to loopback AND to this, so your phone keeps working over
# the tailnet while the public internet still arrives only through Cloudflare.
#
# Leave blank and you simply get no tailnet access — the default is a loopback
# address, so an unset value can never expose the port to the LAN.
TAILSCALE_IP=
