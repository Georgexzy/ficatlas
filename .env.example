# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real secret here.
#
#     cp .env.example .env
#
# Only used by docker-compose.prod.yml. The development stack needs none of it.

# ── Database ────────────────────────────────────────────────────────────────
# The development password is "ficatlas" and is in the git history, so it is
# public. Generate a fresh one:
#
#     openssl rand -base64 32
#
# Changing this AFTER the volume exists does not change the password already
# stored in the database — Postgres only reads POSTGRES_PASSWORD when it
# initialises an empty data directory. To rotate on an existing install:
#
#     docker compose exec db psql -U ficatlas -c "ALTER USER ficatlas PASSWORD 'new';"
#
# then put the same value here.
POSTGRES_PASSWORD=

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# From one.dash.cloudflare.com > Networks > Tunnels > Create a tunnel > Docker.
# The dashboard shows a `docker run ... --token eyJ...` command; the token is
# the long eyJ... string. It grants control of the tunnel — treat it as a
# password.
#
# Configure the tunnel's public hostname to route to:  http://frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=

# ── Who may register ────────────────────────────────────────────────────────
# open   — anyone can create an account
# invite — only with SIGNUP_CODE below
# closed — nobody; accounts are created by hand
#
# The FIRST account created becomes owner (see init_db.py), so make yours before
# opening registration to anyone else.
SIGNUP_MODE=invite
SIGNUP_CODE=

# ── Uptime monitoring ───────────────────────────────────────────────────────
# A dead-man's switch URL. watchdog.sh pings it every 5 minutes ONLY when the
# stack is genuinely healthy, so the alert is the ping going missing — which is
# the only way to learn about a power cut or a dead machine, since a watchdog on
# the box that died cannot tell you it died.
#
# Free options: healthchecks.io, cronitor.io, or an Uptime Kuma push monitor
# hosted somewhere other than this machine.
HEARTBEAT_URL=
