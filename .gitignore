frontend/.next/
frontend/node_modules/

# Runtime data — never commit
backend/data/
**/__pycache__/
*.pyc

# Database dumps — large, and may contain user password hashes
backups/

# Timestamped copies made by apply-prod-frontend.sh before it edits compose.
# Superseded the moment the change is committed, and they accumulate.
*.bak
*.bak.[0-9]*

# Production secrets (see .env.example)
.env
