frontend/.next/
frontend/node_modules/
# ffnet-harvester's was never listed here, so 586 files and 13MB of Playwright
# are committed to the repo — reproducible from its package-lock.json by `npm
# ci`, so they are pure weight on every clone. This rule stops it growing;
# clearing what is already tracked needs a deliberate commit:
#     git rm -r --cached ffnet-harvester/node_modules
ffnet-harvester/node_modules/

# Runtime data — never commit
backend/data/
backend/.fichub_cooldown
**/__pycache__/
*.pyc

# Database dumps — large, and may contain user password hashes
backups/

# Timestamped copies made by apply-prod-frontend.sh before it edits compose.
# Superseded the moment the change is committed, and they accumulate.
*.bak
*.bak.[0-9]*

# Production secrets (see .env.example)
.env
